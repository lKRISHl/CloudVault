APP_NAME=CloudVault
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-development-only
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
EMAIL_FROM=CloudVault <noreply@cloudvault.local>
ACCOUNT_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_MAX=10
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_WINDOW_SECONDS=900
# Production: configure SMTP_USERNAME/SMTP_PASSWORD, enable STARTTLS,
# use HTTPS FRONTEND_URL, and provide a securely generated SECRET_KEY.

DATABASE_URL=postgresql+asyncpg://cloudvault:cloudvault@localhost:5432/cloudvault
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=cloudvault
S3_REGION=us-east-1
S3_USE_SSL=false

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

VITE_API_URL=http://localhost:8000
