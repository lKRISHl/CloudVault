APP_NAME=CloudVault
APP_VERSION=0.1.0
# Native previews require the isolated Linux renderer and shared Unix socket.
# Direct Windows API setups can preview text; use Compose for images/PDFs.
PREVIEW_SOCKET=/preview/renderer.sock
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-development-only
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
EMAIL_FROM=CloudVault <noreply@cloudvault.local>
ACCOUNT_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_MAX=10
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_WINDOW_SECONDS=900
# Production: configure SMTP_USERNAME/SMTP_PASSWORD, enable STARTTLS,
# use HTTPS FRONTEND_URL, and provide a securely generated SECRET_KEY.

DATABASE_URL=postgresql+asyncpg://cloudvault:cloudvault@localhost:5432/cloudvault
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0
# Maintenance lease outlives Celery's 180-second hard task limit.
JOB_LEASE_SECONDS=300
STORAGE_STAGE_BATCH_SIZE=5

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=cloudvault
S3_REGION=us-east-1
# TLS is selected by the endpoint URL; HTTPS is required in production.
S3_ADDRESSING_STYLE=path
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10
UPLOAD_MAX_BYTES=104857600
UPLOAD_URL_SECONDS=900
UPLOAD_COMPLETION_GRACE_SECONDS=300
MULTIPART_MAX_BYTES=1073741824
MULTIPART_PART_BYTES=8388608
MULTIPART_UPLOAD_SECONDS=3600
UPLOAD_CLEANUP_INTERVAL_SECONDS=60
UPLOAD_CLEANUP_SETTLE_SECONDS=300

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

VITE_API_URL=http://localhost:8000

# Short-lived download capabilities (30..900 seconds)
DOWNLOAD_URL_SECONDS=300
